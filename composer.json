{
  "name": "smao/smart-media-auditor-optimizer",
  "description": "Conservative WordPress media auditing and recoverable optimization",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.0" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": { "platform": { "php": "8.0.30" }, "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true } },
  "scripts": { "test": "phpunit", "lint": "phpcs" }
}
